exec("print 2 + 2;");  // expect: 4

exec("fun test() { print 10; }");

test(); // expect: 10

exec("print 5"); 

var result = exec("print 5");
print result.result == nil; // expect: true
print result.errors != nil; // expect: true
print len(result.errors); // expect: 1
print(result.errors[0]); // expect: [line 1] Error at end: Expect ';' after value.
