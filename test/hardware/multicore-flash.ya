import("machine");
import("gpio");
import("timer");

var reps = 2;

fun print_core() {
    print "core: " + string(coreNum());
}

fun flash(n) {

    fun core1(led_pin) {
        print_core();

        gpio_init(led_pin);
        gpio_set_direction(led_pin, true);

        var state = false;
        var tick = 0;
        
        while (tick < n * 2) {
            state = !state;
            gpio_put(led_pin, state);
            sleep_ms(500);
            tick = tick + 1;
        }

        return tick;
    }

    var core = make_routine(core1);
    start(core, pico_led);
    print_core();
    print receive(core).result;
}

flash(reps);
