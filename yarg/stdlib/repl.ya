fun line_repl() {
    while (true) {
        c_stdout_puts("yarg> ");
        var line = c_stdin_gets();
        if (line != nil and line != "") {
            var code = compile(line);
            var errors = code.compileError;
            if (errors == nil) {
                // execute the code in a coroutine, so we can handle runtime errors
                var runner = make_routine(code.result);
                var runner_outcome = resume(runner);
                errors = runner_outcome.error;
            }
            if (errors != nil) {
                for (var i = 0; i < len(errors); i = i + 1) {
                    print errors[i];
                }
            }
        }
        else {
            var feofi = c_stdin_eof(); // c_stdin_gets returns null when pause/continue in lldb
            if (feofi) { // only exit if EOF
                return;
            }
        }
    }
}

fun repl() {
    import("main");
    line_repl();
}
