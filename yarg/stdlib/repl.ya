fun line_repl() {
    while (true) {
        c_stdout_puts("yarg> ");
        var line = c_stdin_gets();
        if (line != nil and line != "") {
            var result = exec(line);
            if (result.compileError != nil) {
                for (var i = 0; i < len(result.compileError); i = i + 1) {
                    print result.compileError[i];
                }
            }
        }
        else {
            var feofi = c_stdin_eof(); // c_stdin_gets returns null when pause/continue in lldb
            if (feofi) { // only exit if EOF
                return;
            }
        }
    }
}

fun repl() {
    import("main");
    line_repl();
}
