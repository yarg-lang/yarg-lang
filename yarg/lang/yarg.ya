// execute source, and return a pair of the result and any errors encountered.
fun exec(source) {
    var target = load(source);
    if (target.compileError == nil) {
        target.result = target.result();
    }
    return target;
}

var yarg_imports = new(any[string]);

fun yarg_library_filename(library, extension) {
    return yarg_library_path + library + extension;
}

fun yarg_library_binary_filename(library) {
    return yarg_library_filename(library, ".yb");
}

fun yarg_library_source_filename(library) {
    return yarg_library_filename(library, ".ya");
}

fun yarg_library_exists(library) {
    var source_path = yarg_library_source_filename(library);
    var binary_path = yarg_library_binary_filename(library);
    return c_fileExists(binary_path) or c_fileExists(source_path);
}

fun exec_xip_index(index) {
    exec(vm_read_xip_file(index, 1));
}

exec_xip_index(3); // xip_library.yb

// load the source represented by library, and execute it if available.
// no result is expected from a loaded library, so returns nil or an array of 
// errors encountered during the import process.
fun import(library) {
    if (yarg_imports[library] == nil and yarg_library_exists(library)) {
        var source;
        if (c_fileExists(yarg_library_binary_filename(library))) {
            yarg_imports[library] = read_yarg_source(yarg_library_binary_filename(library));
            source = yarg_imports[library];
        } else if (c_fileExists(yarg_library_source_filename(library))) {
            yarg_imports[library] = true;
            source = read_yarg_source(yarg_library_source_filename(library));
        }

        var target = load(source);

        if (target.compileError == nil) {
            target.result();
            return nil;
        } else {
            return target.compileError;
        }
    } else if (yarg_imports[library] == nil and xip_library_exists(library)) {
        vm_xip_exec_name(xip_binary_filename(library));
        yarg_imports[library] = true;
        return nil;
    } else if (yarg_imports[library] == nil and library == "main") {
        // main is optional
        return nil;
    } else {
        var any[1] errors;
        errors[0] = "Library not found: " + library;
        return errors;
    }
}

import("repl");
