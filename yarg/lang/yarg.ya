// execute source, and return a pair of the result and any errors encountered.
fun exec(source) {
    var target = load(source);
    if (target.errors == nil) {
        target.result = target.result();
    }
    return target;
}

// Load the XIP library from the predefined node and execute it.
var xip_library_node = 3;
exec(vm_read_xip_file(xip_library_node, 1)); // xip_library.yb

var yarg_imports = new(any[string]);

fun yarg_library_filename(library, extension) {
    return yarg_library_path + library + extension;
}

fun yarg_library_binary_filename(library) {
    return yarg_library_filename(library, ".yb");
}

fun yarg_library_source_filename(library) {
    return yarg_library_filename(library, ".ya");
}

// load the source represented by library, and execute it if available.
// no result is expected from a loaded library, so returns or raises
// an error if the library cannot be loaded.
fun import(library) {
    var binary_source_file = yarg_library_binary_filename(library);
    var text_source_file = yarg_library_source_filename(library);
    var xip_filename = xip_binary_filename(library);

    if (yarg_imports[library] == nil) {
        var source;
        if (c_fileExists(binary_source_file)) {
            source = read_yarg_source(binary_source_file);
        } else if (c_fileExists(text_source_file)) {
            source = read_yarg_source(text_source_file);
        } else if (xip_file_exists(xip_filename)) {
            source = xip_read_file(xip_filename);
        }

        if (source == nil and library != "main") {
            error "Library not found: " + library;
        }

        if (source != nil) {
            var target = load(source);
            if (target.errors == nil) {
                target.result();
                yarg_imports[library] = true;
            } else {
                error target.errors;
            }
        }
    }
}

import("repl");
